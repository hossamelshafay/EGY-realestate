<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Even in dark mode, we show the same ivory launch background.
         The Flutter app is light-mode only; a dark native background would
         cause a visible flash when Flutter draws its first ivory frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowFullscreen">false</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/egy_splash_bg</item>
    </style>
</resources>
