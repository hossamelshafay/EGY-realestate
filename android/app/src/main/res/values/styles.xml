<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied to the Android Window while the process is starting.
         Dismissed automatically when Flutter draws its first frame.
         No logo — just the seamless ivory background. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <!-- Remove any status-bar tint that could cause a flash -->
        <item name="android:windowFullscreen">false</item>
    </style>

    <!-- Theme applied immediately after the LaunchTheme, while Flutter UI initialises.
         Must also be ivory so there is no flash between native and Flutter frames. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/egy_splash_bg</item>
    </style>
</resources>
